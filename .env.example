# Copy these names into Vercel: Project Settings -> Environment Variables (Production + Preview), then redeploy.
# NEVER commit real values. Leave a variable unset to keep that integration switched off.

# Omnisend API key (Store settings -> Integrations & API -> API keys). Needed for email/SMS list signup.
OMNISEND_API_KEY=your-omnisend-api-key

# Twilio Account SID (starts with AC) from the Twilio Console dashboard.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Auth Token from the Twilio Console dashboard (keep secret).
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Twilio Messaging Service SID (starts with MG). Required for scheduled reminders; preferred for all sends.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional fallback sender number in E.164 (e.g. +19545550123). Immediate confirmation only, NO reminders.
TWILIO_FROM=+19545550123

# Optional comma-separated site origins allowed to call the API (e.g. https://www.example.com,https://example.com). Unset = allow all.
ALLOWED_ORIGIN=https://www.example.com
